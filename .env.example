# ── Plaid credentials ─────────────────────────
# Get these from dashboard.plaid.com → Team Settings → Keys
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_sandbox_secret_here
PLAID_ENV=sandbox

# ── Server config ──────────────────────────────
PORT=3000

# ── Security ───────────────────────────────────
# A random string used to verify requests come from your extension
# Generate one at: https://randomkeygen.com
API_SECRET=change_this_to_a_random_string
